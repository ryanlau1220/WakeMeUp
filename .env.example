# Wake Me Up Environment Variables

# OpenAI API Key (Required for AI Wake Plan Generation & CopilotKit Runtime)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specific OpenAI Model (defaults to gpt-4o or gpt-4o-mini)
OPENAI_MODEL=gpt-4o

# CopilotKit Runtime Server Configuration
PORT=3000

# React Native App -> Agent Runtime URL
# For connected physical device via 'adb reverse tcp:3000 tcp:3000', http://localhost:3000/api/copilotkit works directly.
# Alternatively, set your local machine's LAN IP, e.g., http://192.168.1.100:3000/api/copilotkit
COPILOTKIT_RUNTIME_URL=http://localhost:3000/api/copilotkit

# Optional Trusted Contact Escalation (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
