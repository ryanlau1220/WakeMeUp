# Wake Me Up Environment Variables

# LLM Provider Configuration (OpenRouter or OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# If using direct OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CopilotKit Runtime Server Configuration
PORT=3000

# Android app -> Agent Server URL
# Debug defaults to http://localhost:3000 through `adb reverse tcp:3000 tcp:3000`.
# A release build must set an HTTPS endpoint:
# cd android && ./gradlew assembleRelease -PWAKE_ME_UP_SERVER_URL=https://api.example.com

# Optional Trusted Contact Escalation (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
